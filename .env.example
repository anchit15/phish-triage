# Copy to .env or export in your shell. Leave a value empty to use its default.

# Timeout in seconds for every network call. Default: 10
PHISH_TRIAGE_TIMEOUT=

# Directory for cached RDAP results. Default: .cache
PHISH_TRIAGE_CACHE_DIR=

# Set to 1 to skip the TLS handshake, so the suspect host is never contacted. Default: 0
PHISH_TRIAGE_NO_TOUCH=
